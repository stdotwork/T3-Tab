{
  "name": "t3-tab",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
