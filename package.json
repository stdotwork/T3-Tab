{
  "name": "t3-tab",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "e2e": "node e2e/extension.e2e.mjs",
    "bench": "node bench/bench.mjs",
    "bench:compare": "node bench/compare/run.mjs",
    "bench:agent": "node bench/agent/run.mjs"
  },
  "devDependencies": {
    "@browsermcp/mcp": "2.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.86",
    "@t3-tab/server": "workspace:*",
    "@types/node": "26.6.6",
    "agent-browser": "0.45.0",
    "chrome-devtools-mcp": "1.14.0",
    "dev-browser": "1.0.0",
    "gpt-tokenizer": "4.1.2",
    "oxlint": "1.94.0",
    "playwright": "1.65.1",
    "playwriter": "0.12.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
