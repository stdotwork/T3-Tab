    "@modelcontextprotocol/sdk": "1.32.2",
    "@t3-tab/server": "workspace:*",
    "@types/node": "26.6.6",
    "oxlint": "1.94.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
