{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "types": [
      "chrome",
      "node"
    ],
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx"
  },
  "include": [
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "src/**/*.ts",
    "test/**/*.ts",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
